[
  {"type": "project.rename", "name": "A-line skirt"},
  {"type": "project.set_display_unit", "unit": "cm"},

  {"type": "panel.create_polygon", "name": "Front",
   "points": [[0, 0], [560, 0], [470, 600], [90, 600]]},
  {"type": "panel.create_polygon", "name": "Back",
   "points": [[700, 0], [1260, 0], [1170, 600], [790, 600]]},

  {"type": "edge.set_curve", "edge": "$2.created[7]",
   "curve": {"kind": "cubic", "c1": [350, 588], "c2": [210, 588]}},

  {"type": "point.move", "point": "$2.created[2]", "to": [600, 0]},
  {"type": "history.undo"},
  {"type": "history.redo"},
  {"type": "history.undo"},

  {"type": "batch", "commands": [
    {"type": "panel.rename", "panel": "$3.created[0]", "name": "Back skirt"},
    {"type": "panel.translate", "panel": "$3.created[0]", "delta": [50, 0]}
  ]},

  {"type": "panel.get", "panel": "$2.created[0]"},
  {"type": "measure.distance", "a": "$2.created[1]", "b": "$2.created[2]"},
  {"type": "project.summary"}
]
